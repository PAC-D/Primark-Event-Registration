SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Required only by `npm run db:apply`; copy the Supabase direct/session-pooler URI.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
ADMIN_PASSWORD=choose-a-strong-shared-password
SESSION_SECRET=replace-with-at-least-32-random-characters
EVENT_TITLE=Bangladesh Origin

# Local runtime. Use NODE_ENV=production only when the app is served over HTTPS.
PORT=3000
NODE_ENV=development

# Optional local HTTPS (set both). Use a certificate trusted by the Android device.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Maintenance mode: true/1/yes/on answers every page with the maintenance page
# in place (503, no redirect) and returns a 503 MAINTENANCE error for /api calls.
# Off/blank = normal.
MAINTENANCE_MODE=false

# Optional: Power Automate 'When an HTTP request is received' trigger URL (confirmation emails to attendees)
POWER_AUTOMATE_WEBHOOK_URL=
